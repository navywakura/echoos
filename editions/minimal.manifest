# echOS 2.1 — Minimal (LIVE default)
edition: minimal
name: echOS Minimal
version: 2.1.0
kernel: shared
arch: [x86_64]
font: Liberation Mono
ram_budget_kb: 16384
packages:
  echos-base
  echos-shell
  echofetch
  echos-diag
  echos-net
commands:
  - echofetch
  - epk
  - echos-install
  - doas
  - rcctl
  - pfctl
  - disklabel
  - hwprobe
  - ls
  - cat
description: Kernel + ROSH + Heap-0 + epk. LIVE ramdisk. No compilers. No daemons.
